# ---------------------------------------------------------------------------
# 复制成 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交到仓库。
# 生产环境请通过部署平台的环境变量下发这些值。
# ---------------------------------------------------------------------------

# 开发环境填 True，生产环境必须是 False
DJANGO_DEBUG=True

# 生产环境必填。生成方式：
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 后端自己的域名，逗号分隔。生产环境必填，否则所有请求都会 400 DisallowedHost
# 生产：DJANGO_ALLOWED_HOSTS=ideccs.savo-shen.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django admin 表单提交需要，填完整来源，逗号分隔
# 生产：DJANGO_CSRF_TRUSTED_ORIGINS=https://ideccs.savo-shen.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# 允许跨域访问的前端来源（必须带协议，不要带结尾斜杠），逗号分隔。
#
# 生产环境前端和 API 在同一个域名下（nginx 同时提供 index.html 和 /api/），
# 属于同源请求，所以这一项【留空即可】。
# 只有在把前端拆到别的域名时才需要填。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS_ALLOWED_ORIGIN_REGEXES=

# 数据库。默认 SQLite；换 Postgres 直接改成 postgres://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3

# JWT 有效期
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# 是否开放注册
ALLOW_REGISTRATION=True

# 缓存。限流计数存在这里，gunicorn 多 worker 必须用跨进程的缓存，
# 否则登录限流会按 worker 数量翻倍失效。单机部署用 filecache 就够了。
# 生产：CACHE_URL=filecache:///var/tmp/school_mail_cache
CACHE_URL=locmemcache://

# 反向代理层数。Nginx 已用 CF-Connecting-IP 还原了 REMOTE_ADDR，保持 0 即可。
DRF_NUM_PROXIES=0

# 日志级别：DEBUG / INFO / WARNING / ERROR
DJANGO_LOG_LEVEL=INFO

# 生产环境如果 TLS 由上游（Nginx / Cloudflare）终结且未回源 https，设为 False
# SECURE_SSL_REDIRECT=True
