# 复制成 .env.local 可覆盖下面的默认值（.env.local 不会进仓库）

# 后端 API 地址。
#   开发环境填 /api，由 vite 的 dev proxy 转发到本地 Django；
#   生产环境填后端的完整地址，例如 https://api.ideccs.com/api
VITE_API_BASE_URL=/api

# 开发环境 dev proxy 的目标，即本地 Django 的地址
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# 静态资源的基地址。走 CDN 就填 CDN 地址，否则填 /
VITE_ASSET_BASE=/
