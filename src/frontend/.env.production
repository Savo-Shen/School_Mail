# 生产架构：
#   ideccs.savo-shen.com   -> 你的 nginx：只发 2KB 的 index.html + 反代 /api/
#   cdn.savo-shen.com/ideccs/ -> R2 + 阿里云 ESA：承载 21MB 重资源
#
# 因为 index.html 和 API 同域，接口用相对路径即可 —— 完全不需要 CORS。
VITE_API_BASE_URL=/api

# 重资源的基地址。构建产物里的 js/css/图片/字体都会指向这里。
# 结尾的斜杠不能少。
VITE_ASSET_BASE=https://cdn.savo-shen.com/ideccs/
